@* A reusable component for displaying project details *@

<section class="hero-gradient project-detail-hero text-white py-5 shadow-sm">
    <div class="container text-center text-md-start">
        <h2 class="fw-bold mb-0">@Title</h2>
        <p class="mb-0 text-white-50">@Subtitle</p>
    </div>
</section>

<!-- Project Overview -->
<section class="project-detail-section py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <!-- Image -->
            <div class="col-md-6">
                @if (!string.IsNullOrWhiteSpace(MainImage))
                {
                    <button type="button"
                            class="detail-image-button"
                            data-bs-toggle="modal"
                            data-bs-target="#@MainImageModalId"
                            aria-label="Preview @Title main screenshot">
                        <img src="@MainImage"
                             alt="@Title App"
                             class="img-fluid rounded-4 shadow-sm" />
                        <span class="detail-image-icon" aria-hidden="true">
                            <i class="fas fa-search-plus"></i>
                        </span>
                    </button>

                    <div class="modal fade image-preview-modal" id="@MainImageModalId" tabindex="-1" aria-labelledby="@($"{MainImageModalId}-label")" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-xl">
                            <div class="modal-content border-0">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="@($"{MainImageModalId}-label")">@Title</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-0">
                                    <img src="@MainImage" class="img-fluid w-100 preview-modal-image" alt="@Title App">
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Text Content -->
            <div class="col-md-6">
                <h3 class="fw-semibold mb-3">About @Title</h3>
                <p class="text-muted">@AboutDescription</p>

                @if (!string.IsNullOrEmpty(AdditionalDescription))
                {
                    <p class="text-muted">@AdditionalDescription</p>
                }

                @if (Features?.Any() == true)
                {
                    <h5 class="fw-semibold mt-4">Key Features</h5>
                    <ul class="text-muted mb-4">
                        @foreach (var feature in Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrEmpty(TechStack))
                {
                    <h5 class="fw-semibold mt-4">Technology Stack</h5>
                    <p class="text-muted" @onclick:stopPropagation="true">
                        @((MarkupString)TechStack)
                    </p>
                }

                <div class="project-detail-actions">
                    @if (!string.IsNullOrEmpty(ContactUrl))
                    {
                        <a href="@ContactUrl" class="btn btn-primary rounded-pill px-4">Contact Me</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(RepositoryUrl))
                    {
                        <a href="@RepositoryUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark rounded-pill px-4">
                            <i class="fab fa-github me-2" aria-hidden="true"></i>GitHub Repository
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Additional Images -->
@if (AdditionalImages?.Any() == true)
{
    <section class="project-screens-section py-5">
        <div class="container">
            <div class="text-center mb-4">
                <h4 class="fw-bold">Application Screens</h4>
                <p class="text-muted mb-0">A quick look at the @Title interface</p>
            </div>

            <div class="row g-4">
                @for (var i = 0; i < AdditionalImages.Count; i++)
                {
                    var img = AdditionalImages[i];
                    var modalId = GetImageModalId("screen", i);

                    <div class="col-md-4">
                        <button type="button"
                                class="detail-image-button screen-image-button"
                                data-bs-toggle="modal"
                                data-bs-target="#@modalId"
                                aria-label="Preview @Title screenshot @(i + 1)">
                            <img src="@img"
                                 class="img-fluid rounded-4 shadow-sm w-100"
                                 alt="@Title image @(i + 1)" />
                            <span class="detail-image-icon" aria-hidden="true">
                                <i class="fas fa-search-plus"></i>
                            </span>
                        </button>

                        <div class="modal fade image-preview-modal" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}-label")" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-xl">
                                <div class="modal-content border-0">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="@($"{modalId}-label")">@Title screenshot @(i + 1)</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-0">
                                        <img src="@img" class="img-fluid w-100 preview-modal-image" alt="@Title image @(i + 1)" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}