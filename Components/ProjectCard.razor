@using Microsoft.AspNetCore.Components

<div class="card project-card h-100 border-0">
    <button type="button"
            class="project-image-button"
            data-bs-toggle="modal"
            data-bs-target="#@ModalId"
            aria-label="Preview @Title image">
        <img src="@ImageUrl" class="card-img-top" alt="@Title">
        <span class="project-image-icon" aria-hidden="true">
            <i class="fas fa-search-plus"></i>
        </span>
    </button>

    <div class="card-body p-4 d-flex flex-column">
        <h5 class="card-title fw-semibold">@Title</h5>
        <p class="card-text text-muted small">@Description</p>
        <a href="@DetailsUrl" class="btn btn-outline-primary btn-sm rounded-pill mt-auto align-self-start">View Details</a>
    </div>
</div>

<div class="modal fade image-preview-modal" id="@ModalId" tabindex="-1" aria-labelledby="@($"{ModalId}-label")" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0">
            <div class="modal-header">
                <h5 class="modal-title" id="@($"{ModalId}-label")">@Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <img src="@ImageUrl" class="img-fluid w-100 preview-modal-image" alt="@Title">
            </div>
        </div>
    </div>
</div>
