@page "/teambridg-tracker"
@using MzTech.Components

<ProjectDetails 
    Title="@Title"
    Subtitle="Team Bridg Tracker is a project management tool that streamlines collaboration, monitors progress,
            and boosts productivity through effective communication and task tracking."
    MainImage="@MainImage"
    AboutDescription="@AboutDescription"
    AdditionalDescription="@AdditionalDescription"
    TechStack="@TechStack"
    ContactUrl="@ContactUrl"
    Features="@Features"
    AdditionalImages="@AdditionalImages" />

@code {
    private string Title = "Team Bridg Tracker";
    private string MainImage = "images/teambridg-tracker.png";

    private string AboutDescription = "Team Bridg Tracker is a collaborative project management platform designed to improve productivity and transparency across teams by providing a centralized space for managing tasks and milestones.";

    private string AdditionalDescription = "The system helps teams coordinate effectively, visualize workloads, and identify potential bottlenecks before they impact delivery. With live progress updates, it ensures accountability and seamless project execution.";

    private string TechStack = "Built with <strong>DevExpress XAF Blazor Server</strong> and <strong>ASP.NET Core</strong>, utilizing <strong>Entity Framework Core</strong> and <strong>Azure Services</strong>.";

    private string ContactUrl = "/contact";

    private List<string> Features = new()
    {
        "Task creation, assignment, and progress tracking",
        "Real-time updates and notifications",
        "Integrated security system",
        "Project dashboards and performance analytics",
        "Secure, role-based access control"
    };

    private List<string> AdditionalImages = new()
    {
        "images/teambridg-dashboard.svg",
        "images/teambridg-board.svg",
        "images/teambridg-timeline.svg"
    };
}
