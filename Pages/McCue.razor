@page "/mccue"
@using MzTech.Components

<ProjectDetails 
    Title="@Title"
    Subtitle="@Subtitle"
    MainImage="@MainImage"
    AboutDescription="@AboutDescription"
    AdditionalDescription="@AdditionalDescription"
    TechStack="@TechStack"
    ContactUrl="@ContactUrl"
    Features="@Features"
    AdditionalImages="@AdditionalImages" />

@code {
    private string Title = "McCue";
    private string Subtitle = "A software solution that manages inventory and generates sales and service order reports for industrial safety equipment.";

    private string MainImage = "images/mccue.png";

    private string AboutDescription = "McCue is an industrial-grade software solution built to manage inventory, process sales and service orders, and generate actionable reports for industrial safety equipment operations.";

    private string AdditionalDescription = "It empowers warehouse teams and service departments with real-time data on stock levels, order fulfillment, and product tracking. McCue streamlines the entire workflow from customer order to delivery and after-sales service reporting.";

    private string TechStack = "Developed using <strong>DevExpress XAF Blazor Server</strong> and <strong>ASP.NET Core </strong>, leveraging <strong>Xpress Persistent Object (XPO)</strong> for data persistence and <strong>SQL Server</strong> as the backend database.";

    private string ContactUrl = "/contact";

    private List<string> Features = new()
    {
        "Inventory tracking and low-stock alerts",
        "Sales and service order management",
        "Comprehensive reporting and analytics dashboard",
        "Role-based access control for staff and admins",
        "Seamless integration with third-party services"
    };

    private List<string> AdditionalImages = new()
    {
        "images/MC-Home.png",
        "images/MC-Reports.png"
    };
}
