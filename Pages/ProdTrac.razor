@page "/prodtrac"
@using MzTech.Components

<ProjectDetails 
    Title="@Title"
    Subtitle="@Subtitle"
    MainImage="@MainImage"
    AboutDescription="@AboutDescription"
    AdditionalDescription="@AdditionalDescription"
    TechStack="@TechStack"
    ContactUrl="@ContactUrl"
    Features="@Features"
    AdditionalImages="@AdditionalImages" />

@code {
    private string Title = "ProdTrac";
    private string Subtitle = "A production tracking software that monitors and manages the progress and completion of building projects.";

    private string MainImage = "images/actual.png";

    private string AboutDescription = "ProdTrac is a powerful production tracking software designed for construction and manufacturing teams to monitor project progress, manage completion timelines, and ensure production milestones are met efficiently.";

    private string AdditionalDescription = "It centralizes production workflows, providing visibility into each phase of a build project. With real-time tracking and reporting, ProdTrac helps project managers identify bottlenecks and make informed decisions to keep operations running smoothly.";

    private string TechStack = "Built using <strong>DevExpress XAF Blazor Server</strong> and <strong>ASP.NET Core</strong>, leveraging <strong>Xpress Persistent Objects (XPO)</strong> and <strong>SQL Server</strong> for data persistence. The frontend uses <strong>Bootstrap 4</strong> for a responsive user interface.";

    private string ContactUrl = "/contact";

    private List<string> Features = new()
    {
        "Real-time production tracking and reporting",
        "Automated alerts for project milestones",
        "Data visualization for progress analysis",
        "Progress updates for ongoing activities"
    };


    private List<string> AdditionalImages = new()
    {
        "images/PT-Timeline.png",
        "images/PT-Activity.png",
        "images/PT-Dashboard.png"
    };
}
