@page "/inductability"
@using MzTech.Components

<ProjectDetails 
    Title="@Title"
    Subtitle="@SubTitle"
    MainImage="@MainImage"
    AboutDescription="@AboutDescription"
    AdditionalDescription="@AdditionalDescription"
    TechStack="@TechStack"
    ContactUrl="@ContactUrl"
    Features="@Features"
    AdditionalImages="@AdditionalImages" />

@code {
    private string Title = "Inductability";
    private string SubTitle = "A comprehensive platform that simplifies employee onboarding, enhances training, and allows the creation of custom induction modules and questionnaires.";

    private string MainImage = "images/inductability.png";

    private string AboutDescription = "Inductability is a comprehensive onboarding and training management platform that simplifies employee induction and compliance tracking. It enables businesses to design, deploy, and monitor customized induction programs efficiently.";

    private string AdditionalDescription = "The system provides digital forms, video modules, and real-time progress dashboards that help organizations streamline staff onboarding, maintain compliance records, and ensure consistent training outcomes.";

    private string TechStack = "Built using <strong>Blazor Server</strong> and <strong>ASP.NET Core</strong>, integrated with <strong>Azure Storage</strong> for document handling and <strong>Entity Framework Core</strong> for data management.";

    private string ContactUrl = "/contact";

    private List<string> Features = new()
    {
        "Create and customize induction modules and assessments",
        "Monitor completion rates and generate detailed reports",
        "Track employee compliance status in real-time",
        "Integrate multimedia learning materials and policies",
        "Cloud-based with secure authentication and data storage"
    };

    private List<string> AdditionalImages = new()
    {
        "images/IND-registation-complete.png",
        "images/IND-module.png",
        "images/IND-locked-module.png",
        "images/IND-MyInductions.png",
        "images/IND-user.png",
        "images/IND-tenant-management.png",
        "images/IND-registration.png",
        "images/IND-dashboard.png"
    };
}
