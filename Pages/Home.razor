@page "/"
@using MzTech.Components

<PageTitle>MZ Tech</PageTitle>

<section class="hero home-hero">
    <div class="container hero-container">
        <div class="row align-items-center hero-banner-row">
            <div class="col-12">
                <div class="hero-copy">
                    <h1 class="display-4 fw-bold mb-3">
                        Hi, I'm <span class="text-primary">MZ</span>
                    </h1>
                    <p class="lead mb-4">
                        <span class="hero-intro-line">A passionate software developer building modern</span>
                        <span class="hero-intro-line">and impactful software solutions.</span>
                    </p>
                    <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-md-start gap-3 hero-actions">
                        <a href="#projects" class="btn btn-primary btn-lg px-4 rounded-pill">
                            <i class="fas fa-layer-group me-2" aria-hidden="true"></i>View My Work
                        </a>
                        <a href="#contact" class="btn btn-outline-primary btn-lg px-4 rounded-pill">
                            <i class="fas fa-paper-plane me-2" aria-hidden="true"></i>Get In Touch
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-background-preview" aria-hidden="true">
        <img src="images/MZTechBanner.png" alt="" />
    </div>
</section>

<!-- Projects Section -->
<section id="projects" class="py-5 projects-section">
    <div class="container">
        <!-- Section Heading -->
        <div class="section-heading mb-5">
            <h2 class="fw-bold display-6">Featured Projects</h2>
            <p class="text-muted fs-5">A selection of my recent works with various clients.</p>
        </div>

        <!-- Project Cards -->
        <div class="row g-4">
            <div class="col-md-4">
                 <ProjectCard 
                    Title="Lending Fabric"
                    Description="A Lending Fabric is a refinance application software that streamlines loan processing,
                            improves efficiency, and simplifies refinancing for lenders and borrowers."
                             ImageUrl="images/LF-DealUser.png"
                             DetailsUrl="/lending-fabric" />
            </div>

            <div class="col-md-4">
                <ProjectCard Title="Teambridg Tracker"
                    Description="Team Bridg Tracker is a project management tool that streamlines collaboration, monitors progress,
                        and boosts productivity through effective communication and task tracking."
                    ImageUrl="images/teambridg-tracker.png"
                    DetailsUrl="/teambridg-tracker" />
               
            </div>

            <div class="col-md-4">
                <ProjectCard Title="DealerIQ"
                             Description="DealeIQ is a software solution for car dealerships that streamlines sales, service operations, and customer call management."
                             ImageUrl="images/SalesIQ-1.png"
                             DetailsUrl="/dealeriq" />
            </div>
           
            <!-- Hidden Projects (collapse) -->
            <div class="collapse mt-4" id="moreProjects">
                <div class="row g-4">


                    <div class="col-md-4">
                        <ProjectCard Title="Rental Manager Xpress (RMX)"
                                     Description="RMX is a rental management software designed to simplify and streamline property rentals, specifically tailored for RV owners."
                                     ImageUrl="images/Scheduler.jpg"
                                     DetailsUrl="/rmx" />
                    </div>

                    <div class="col-md-4">
                        <ProjectCard Title="Owners Rental Program (ORP)"
                                     Description="ORP is a rental management solution designed for RV owners, helping them efficiently manage properties, track rentals, and generate detailed statements"
                                     ImageUrl="images/ORp.jpg"
                                     DetailsUrl="/orp" />
                    </div>
                    <div class="col-md-4">
                        <ProjectCard Title="McCue"
                                     Description="McCue is a software solution that manages inventory and generates sales and service order reports for industrial safety equipment."
                                     ImageUrl="images/mccue.png"
                                     DetailsUrl="/mccue" />
                    </div>
                    <div class="col-md-4">
                        <ProjectCard Title="ProdTrac"
                                     Description="ProdTrac is a production tracking software that monitors and manages the progress and completion of building projects."
                                     ImageUrl="images/actual.png"
                                     DetailsUrl="/prodtrac" />
                    </div>

                    <div class="col-md-4">
                        <ProjectCard Title="KRX and FWD"
                                     Description="KRX and FWD is an Excel COM add-in for forecasting net cash flow."
                                     ImageUrl="images/forecast.png"
                                     DetailsUrl="/krx-and-fwd" />
                    </div>
                </div>
            </div>

            <!-- Show More Button -->
            <div class="text-center mt-4">
                <button class="btn btn-outline-primary rounded-pill px-4 project-toggle-button" type="button" data-bs-toggle="collapse" data-bs-target="#moreProjects" aria-expanded="false" aria-controls="moreProjects">
                    Show More Projects
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Ongoing Development Projects -->
<section id="ongoing-projects" class="py-5 ongoing-projects-section">
    <div class="container">
        <div class="section-heading mb-5">
            <h2 class="fw-bold display-6">Ongoing Development Projects</h2>
            <p class="text-muted fs-5">Some personal coding projects to improve my skills and stay up to date with the latest technologies.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <ProjectCard Title="AI-Powered Plan Analysis and Quotation Generation"
                             Description="A personal coding project for extracting plan details, analyzing project requirements, and generating AI-assisted quotation drafts."
                             ImageUrl="images/ai-plan-quotation.svg"
                             DetailsUrl="/ai-plan-quotation" />
            </div>
            <div class="col-md-6">
                <ProjectCard Title="Online Cabinet Configurator"
                             Description="A personal coding project for configuring cabinet layouts, finishes, dimensions, and quote-ready selections in a responsive web interface."
                             ImageUrl="images/cabinet-configurator.svg"
                             DetailsUrl="/online-cabinet-configurator" />
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-5 contact-section">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-5">
                <div class="contact-panel h-100">
                    <h4 class="fw-bold text-primary mb-3">Get in Touch</h4>
                    <p class="text-muted mb-4">
                        Whether you have a question, want to collaborate, or discuss your next project — I’d love to hear from you.
                    </p>

                    <ul class="contact-list list-unstyled mb-4">
                        <li>
                            <span class="icon-circle bg-primary text-white">
                                <i class="fas fa-envelope" aria-hidden="true"></i>
                            </span>
                            <a href="mailto:mattinfotech23@gmail.com">mattinfotech23@gmail.com</a>
                        </li>

                        <li>
                            <span class="icon-circle bg-primary text-white">
                                <i class="fab fa-whatsapp" aria-hidden="true"></i>
                            </span>
                            <a href="tel:+639353923844">+63 9353923844</a>
                        </li>

                        <li>
                            <span class="icon-circle bg-primary text-white">
                                <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            </span>
                            <span>Davao City, Philippines</span>
                        </li>
                    </ul>

                    <div class="d-flex gap-3 mt-3" aria-label="Social media links">
                        <a href="https://www.linkedin.com/in/matiaslagat/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
                            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                        </a>
                        <a href="https://github.com/mattinfotech" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
                            <i class="fab fa-github" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="contact-form-card h-100">
                    <h5 class="fw-semibold mb-3">Send Me a Message</h5>
                    <form action="https://formspree.io/f/mjkaaljq" method="POST">
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold">Full Name</label>
                            <input type="text" id="name" name="name" class="form-control" placeholder="Your name" required />
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">Email Address</label>
                            <input type="email" id="email" name="_replyto" class="form-control" placeholder="you@example.com" required />
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label fw-semibold">Message</label>
                            <textarea id="message" name="message" class="form-control" rows="5" placeholder="Type your message here..." required></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="fas fa-paper-plane me-2" aria-hidden="true"></i> Send Message
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
