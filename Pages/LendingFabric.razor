@page "/lending-fabric"
@using MzTech.Components

<ProjectDetails Title="Lending Fabric"
                Subtitle="A refinance application platform for streamlined loan processing"
                MainImage="images/LF-DealUser.png"
                AboutDescription="Lending Fabric is a refinance application software designed to streamline and automate the loan refinancing process."
                AdditionalDescription="It is a multi-tenant platform that integrates intelligent document processing, borrower risk profiling, and workflow management tools, enabling financial institutions to process refinancing requests with greater speed, accuracy, and compliance."
                TechStack="Built with <strong>DevExpress XAF Blazor Server</strong> and <strong>ASP.NET Core</strong>, utilizing <strong>Entity Framework Core</strong> and <strong>Azure Services</strong>."
                ContactUrl="/contact"
                Features="@Features"
                AdditionalImages="@Images" />

@code {
    private List<string> Features = new()
    {
        "Automated loan data verification and validation",
        "Borrower risk assessment and scoring system",
        "Workflow tracking for end-to-end loan lifecycle",
        "Cloud-based, scalable architecture",
        "Secure API integrations with third-party systems"
    };

    private List<string> Images = new()
    {
        "images/LF-Contact.png",
        "images/LF-DealUser.png",
        "images/LF-NewLeads.png"
    };
}