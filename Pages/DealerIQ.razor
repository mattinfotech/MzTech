@page "/dealeriq"
@using MzTech.Components

<ProjectDetails 
    Title="@Title"
    Subtitle="@SubTitle"
    MainImage="@MainImage"
    AboutDescription="@AboutDescription"
    AdditionalDescription="@AdditionalDescription"
    TechStack="@TechStack"
    ContactUrl="@ContactUrl"
    Features="@Features"
    AdditionalImages="@AdditionalImages" />

@code {
    private string Title = "DealerIQ";
    private string SubTitle = "A software solution for car dealerships that streamlines sales, service operations, and customer call management.";
    private string MainImage = "images/SalesIQ-1.png";
    private string AboutDescription = "DealerIQ is a comprehensive automotive dealership management solution that integrates sales, service, and customer communication into one streamlined platform.";
    private string AdditionalDescription = "It helps dealerships enhance operational efficiency by automating workflows, managing service appointments, tracking sales performance, and improving customer engagement through intelligent call handling and analytics.";
    private string TechStack = "Developed with <strong>ASP.NET Core</strong> using the <strong>DevExpress XAF Blazor Server</strong> framework, powered by <strong>Xpress Persistent Objects (XPO)</strong> and <strong>Azure Cloud Services</strong> for deployment.";
    private string ContactUrl = "/contact";
    private List<string> Features = new()
    {
        "Generate monthly quotations",
        "Track customer calls and analyze interactions",
        "Automate daily service appointment notifications",
        "Import sales leads and service data",
        "Support for multitenancy",
        "Real-time reporting and insights"
    };

    private List<string> AdditionalImages = new()
    {
        "images/DQ-CCL-2.png",
        "images/DQ-CCL.png",
        "images/DQ-DMP.png",
        "images/DQ-Report.png",
        "images/DQ-User.png"
    };
}